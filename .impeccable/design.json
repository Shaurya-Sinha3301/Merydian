  "narrative": {
    "northStar": "The Printed Timetable",
    "overview": "A trip is read like a Kursbuch page: white paper on a pale cool ground, ruled columns of times and stops, ink type, and every revision shown as a correction in the margin rather than a highlight. The system is flat, near-square and typographic. Colour is scarce and always carries meaning; nothing is decorative.\n\nDensity is that of a reference table: tabular numerals for every time and amount, hairline rules between rows, a 2px ink rule under table headers. Photographs appear only as small framed plates with captions and credits; maps are real OpenStreetMap insets. The chosen version of a plan is drawn solid, earlier versions dashed.",
    "keyCharacteristics": [
      "White paper (#ffffff) on pale ground; ink text; hairline rules.",
      "Four signals, each with one meaning; tinted fills only on stamps and alerts.",
      "2-3px corners, no shadows at rest.",
      "One typeface (Archivo, weight 700 for headings, normal width), tabular numerals globally.",
      "Emphasis by underline, never by highlight."
    ],
    "rules": [
      { "name": "The Signal Meaning Rule", "body": "Navy, forest, red and amber each mean exactly one thing (action/AI, added/approved, withdrawn/attention, pending). Never use them as decoration or for brand flavour.", "section": "colors" },
      { "name": "The Correction Rule", "body": "A revision is shown by tone, tag and dashed-versus-solid drawing, not by a highlight fill behind running text.", "section": "colors" },
      { "name": "The Tabular Rule", "body": "Every time, price and count uses tabular numerals; right-align numbers with the .num treatment.", "section": "typography" },
      { "name": "The Flat Rule", "body": "Nothing carries a shadow at rest.", "section": "elevation" }
    ],
    "dos": [
      "Do keep emphasis to underlines, rules and tags.",
      "Do draw withdrawn or earlier-version items dashed and chosen items solid.",
      "Do credit every photograph and caption it as a plate.",
      "Do keep numerals tabular and right-aligned in tables."
    ],
    "donts": [
      "Don't add shadows, gradients or rounded corners above 3px to panels.",
      "Don't use colour bars or tinted bands as decoration; Bands is a deliberate no-op kept only so old callers compile.",
      "Don't use a signal colour for anything but its meaning.",
      "Don't nest panels or build soft travel-app cards."
    ]
  }
