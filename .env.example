# ============================================================================
# MeiliAI — Environment Variables Template
# Copy this file to .env and fill in all required values.
# DO NOT commit the real .env to source control.
# ============================================================================

# ── Application ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Security (REQUIRED) ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production_at_least_32_chars

# ── PostgreSQL (REQUIRED) ────────────────────────────────────────────────────
SQLALCHEMY_DATABASE_URI=postgresql://meiliai:meiliai_secret@localhost:5432/meiliai

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API ports ────────────────────────────────────────────────────────────────
API_PORT=8000
FLOWER_PORT=5555

# ── AI Agents (at least one key required for FeedbackAgent to work) ─────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── TBO Hotel API ────────────────────────────────────────────────────────────
TBO_API_URL=http://api.tbotechnology.in/TBOHolidays_HotelAPI
TBO_USERNAME=your_tbo_username
TBO_PASSWORD=your_tbo_password

# ── TBO Air API ──────────────────────────────────────────────────────────────
TBO_AIR_AUTHENTICATE_URL=http://Sharedapi.tektravels.com/SharedData.svc/rest
TBO_AIR_SERVICE_URL=http://api.tektravels.com/BookingEngineService_Air/AirService.svc/rest
TBO_AIR_USERNAME=your_tbo_air_username
TBO_AIR_PASSWORD=your_tbo_air_password

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_CONCURRENCY=4
UVICORN_WORKERS=2

# ── Flower Monitoring ────────────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# ── Real use (non-demo) ───────────────────────────────────────────────────────
# Entering this code at sign-up creates a travel agent account. Empty turns agent sign-up off.
AGENT_SIGNUP_CODE=choose-a-long-random-phrase
# A traveller's own first plan is published straight away; later changes still need an agent.
SELF_SERVE_AUTO_APPROVE=true
# The public address of the web app. Used for the links in emails and texts.
FRONTEND_URL=http://localhost:5173
# Webhooks may only call public URLs. Leave false in production.
WEBHOOK_ALLOW_PRIVATE=false
# Local testing only: exposes /dev/outbox so reset links can be read. NEVER true in production.
DEV_OUTBOX=false

# ── Email (optional; without it messages are recorded as "logged") ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── SMS via Twilio (optional) ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Demo sandbox ─────────────────────────────────────────────────────────────
DEMO_ENABLED=true
DEMO_ADMIN_KEY=generate-a-long-random-value
SEED_ON_START=false

# ── Tests ────────────────────────────────────────────────────────────────────
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123
